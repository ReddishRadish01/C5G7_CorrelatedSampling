# User-editable inputs for the CS/Newton critical rod-depth search.
# Values supplied as sbatch NAME=value arguments take precedence over these.

# Monte Carlo calculation
: "${PARTICLES:=2000000}"
: "${INACTIVE:=100}"
: "${ACTIVE:=200}"
: "${BASE_SEED:=92235922383}"

# Search interval and initial point, in cm from the top
: "${INITIAL_DEPTH_CM:=64.24}"
: "${LOWER_CM:=21.42}"
: "${UPPER_CM:=128.52}"
: "${TARGET_K:=1.0}"

# Correlated-sampling derivative and safeguarded Newton update
: "${PROBE_STEP_CM:=0.25}"
: "${MIN_PROBE_STEP_CM:=0.03125}"
: "${MAX_PROBE_RETRIES:=3}"
: "${CS_GENERATIONS:=10}"
: "${DAMPING:=1.0}"
: "${MAX_NEWTON_STEP_CM:=30.0}"
: "${MAX_ITER:=8}"

# Stopping/statistical criteria
: "${DEPTH_TOL_CM:=0.01}"
: "${K_TOL_PCM:=10.0}"
: "${MAX_K_STDERR_PCM:=10.0}"
: "${MIN_SLOPE_SIGMA:=3.0}"
: "${CONFIDENCE_SIGMA:=2.0}"
# Accept the L10-L9 source tail when its confidence upper bound is below
# max(SOURCE_TAIL_ABS_PCM, SOURCE_TAIL_REL_FRACTION * |DeltaK|).
: "${SOURCE_TAIL_ABS_PCM:=1.0}"
: "${SOURCE_TAIL_REL_FRACTION:=0.02}"
# A required h/2 validation accepts slopes within this relative difference or
# within CONFIDENCE_SIGMA times their combined standard error.
: "${MAX_SLOPE_RELATIVE_DIFFERENCE:=0.05}"
: "${REQUIRE_SOURCE_CONVERGENCE:=1}"
: "${FINAL_DIRECT_CHECK:=1}"

# CUDA build (set NO_BUILD=1 to reuse an existing build/c5g7 executable)
: "${CUDA_ARCH:=native}"
# One warp per block (32) caps the resident-warp count on Ada GPUs because an
# SM can host only a finite number of blocks. Two warps is the conservative
# server default; override this after measuring 32/64/128 on the target GPU.
: "${THREADS_PER_BLOCK:=64}"
: "${DEVICE_LTO:=1}"
: "${FAST_MATH:=1}"
: "${NO_BUILD:=0}"

# Slurm job-step performance settings. Slurm applies clock requests only when
# the cluster permits them and resets the clocks after the step.
: "${GPU_BIND:=closest}"
: "${REQUEST_HIGH_CLOCKS:=1}"
