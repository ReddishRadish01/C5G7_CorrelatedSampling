# Additional reference depths for covering the full ARO-to-ARI rod-worth curve.
# This file is consumed by run_cs_prediction_validation_slurm.sbatch.
# Command-line NAME=value arguments still override every setting below.

# Reuse the completed points at 64, 72, 80, 83.6388953145, 88, and 92.5 cm.
# Add the missing ARO-side and ARI-side positions at approximately 8 cm
# spacing.  The final reference depth 128.395 cm uses the 0.125 cm probe to
# place its direct target exactly at the modeled ARI position, 128.52 cm.
# There are 13 additional depths x 3 runs = 39 independent GPU tasks:
# direct(d), direct(d+h), and CS(d -> d+h).
: "${REFERENCE_DEPTHS_CM:=0.0 8.0 16.0 24.0 32.0 40.0 48.0 56.0 96.0 104.0 112.0 120.0 128.395}"

# Use a new odd seed range so these runs do not reuse the completed study's
# random-number streams.
: "${BASE_SEED:=92239010101}"

# Keep the same production settings so the new rows can be compared directly
# with cs_prediction_validation_slurm_5615.
: "${PROBE_STEP_CM:=0.125}"
: "${MODELED_UPPER_DEPTH_CM:=128.52}"
: "${PARTICLES:=10000000}"
: "${INACTIVE:=100}"
: "${ACTIVE:=200}"
: "${CS_GENERATIONS:=10}"

: "${CONFIDENCE_SIGMA:=2.0}"
: "${EXPECTED_DELTA_K_SIGN:=-1}"
: "${SOURCE_TAIL_ABS_PCM:=1.0}"
: "${SOURCE_TAIL_REL_FRACTION:=0.02}"

# Same optimized CUDA build and enforced six-GPU node3 execution.
: "${BUILD_TARGET:=build/c5g7_cs_validation_slurm}"
: "${NVCC_BIN:=nvcc}"
: "${CUDA_ARCH:=native}"
: "${THREADS_PER_BLOCK:=64}"
: "${DEVICE_LTO:=1}"
: "${FAST_MATH:=1}"
: "${NO_BUILD:=0}"
: "${FORCE_BUILD:=0}"
: "${BUILD_JOBS:=4}"
: "${GCC_MODULE:=}"
: "${CUDA_MODULE:=}"
: "${HOST_COMPILER:=}"
: "${GPU_WORKERS:=6}"
: "${MONITOR_INTERVAL_SEC:=300}"
