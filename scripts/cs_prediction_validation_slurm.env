# User-editable settings for the multi-GPU CS validation study.
# Command-line NAME=value arguments to the sbatch script override these values.

# Reference rod insertion depths [cm, measured from the top of the core].
# One local forward perturbation is tested at every reference depth.
: "${REFERENCE_DEPTHS_CM:=64.0 72.0 80.0 83.6388953145 88.0 92.5}"
: "${PROBE_STEP_CM:=0.125}"
: "${MODELED_UPPER_DEPTH_CM:=128.52}"

# Production Monte Carlo statistics requested for this validation.
: "${PARTICLES:=10000000}"
: "${INACTIVE:=100}"
: "${ACTIVE:=200}"
: "${CS_GENERATIONS:=10}"

# The three calculations at each depth use different odd seeds:
# direct(d), direct(d+h), and CS(d -> d+h).
: "${BASE_SEED:=92239000101}"

# Statistical checks used by the postprocessor.
: "${CONFIDENCE_SIGMA:=2.0}"
: "${EXPECTED_DELTA_K_SIGN:=-1}"
# The L10-L9 source-tail upper bound must be below
# max(SOURCE_TAIL_ABS_PCM, SOURCE_TAIL_REL_FRACTION * |CS delta-k|).
: "${SOURCE_TAIL_ABS_PCM:=1.0}"
: "${SOURCE_TAIL_REL_FRACTION:=0.02}"

# CUDA build. The sbatch script compiles before launching the GPU workers.
: "${BUILD_TARGET:=build/c5g7_cs_validation_slurm}"
: "${NVCC_BIN:=nvcc}"
: "${CUDA_ARCH:=native}"
: "${THREADS_PER_BLOCK:=64}"
: "${DEVICE_LTO:=1}"
: "${FAST_MATH:=1}"
: "${NO_BUILD:=0}"
: "${FORCE_BUILD:=0}"
: "${BUILD_JOBS:=4}"

# Optional server modules/toolchain. Leave empty when nvcc and g++ are already
# usable. Otherwise set names such as GCC_MODULE=gcc/12.2 and/or
# CUDA_MODULE=cuda/12.4 according to `module avail` on the server.
: "${GCC_MODULE:=}"
: "${CUDA_MODULE:=}"
# Optional absolute path to a compatible g++, e.g. /usr/bin/g++.
: "${HOST_COMPILER:=}"

# Runtime. This is deliberately fixed at six: every physical GPU on node3.
: "${GPU_WORKERS:=6}"
: "${MONITOR_INTERVAL_SEC:=300}"
